# Flask Configuration
# Use a strong, random secret key in production (minimum 32 characters)
SECRET_KEY=your_secret_key_here_change_in_production

# Database Configuration
# For SQLite: sqlite:///database.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///database.db

# Admin Credentials (Optional - for hardcoded admin login)
# Consider removing hardcoded credentials in production and use a proper authentication system
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# Flask Environment
# Set to 'development' or 'production'
FLASK_ENV=development
